# Copy this file to .env and fill in real values.

# ── OpenAI ───────────────────────────────────────────────────────────────────
# LLM_PROVIDER chooses the chat backend: "openai" (paid, needs key below) or
# "ollama" (free, local — see ollama settings further down). Embeddings are
# controlled separately by EMBEDDING_PROVIDER and already default to "local".
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434/v1

# ── Ollama (free local LLM, used when LLM_PROVIDER=ollama) ──────────────────
# Install from https://ollama.com, then: ollama pull llama3.1
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1

# ── Embeddings ───────────────────────────────────────────────────────────────
# "local" = free, offline, sentence-transformers (384-dim)
# "openai" = paid, higher quality (1536-dim) — requires OPENAI_API_KEY
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Qdrant ───────────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=documents

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DSN=postgresql+asyncpg://postgres:postgres@localhost:5432/ragdb

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_CHAT_TTL_SECONDS=86400
CHAT_HISTORY_MAX_MESSAGES=20

# ── Ingestion ────────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=20
DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=50
SEMANTIC_SIMILARITY_THRESHOLD=0.3

# ── Retrieval ────────────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=4
